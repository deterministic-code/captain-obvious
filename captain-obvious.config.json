{
  "mode": "local",
  "gitHooks": {
    "prePush": ["run: npx tsc -p core/tsconfig.json --noEmit"]
  },
  "npmScripts": {
    "extraScripts": {
      "lint:dead-code": "dead-code --all"
    }
  },
  "claudeHooks": [
    {
      "event": "PreToolUse",
      "matcher": "Edit|Write|NotebookEdit|Bash",
      "hook": "pre-tool-guard",
      "timeout": 5
    },
    {
      "event": "PostToolUse",
      "matcher": "Edit|Write|NotebookEdit",
      "hook": "tool-fix",
      "timeout": 20
    },
    {
      "event": "Stop",
      "hook": "stop-guard",
      "timeout": 15
    }
  ]
}
