{
  "name": "captain-obvious-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "core",
    "rules/_kit",
    "rules/gov-main-ci-green",
    "rules/gov-no-push-to-main",
    "rules/gov-require-pr",
    "rules/lint-comments",
    "rules/lint-complexity",
    "rules/lint-coverage",
    "rules/lint-dead-code",
    "rules/lint-dup",
    "rules/lint-dup-fn",
    "rules/lint-dup-structural",
    "rules/lint-emitter-casing",
    "rules/lint-empty-catch",
    "rules/lint-empty-tests",
    "rules/lint-frozen-interfaces",
    "rules/lint-max-file-lines",
    "rules/lint-max-line-length",
    "rules/lint-max-lines",
    "rules/lint-max-params",
    "rules/lint-max-statements",
    "rules/lint-naming",
    "rules/lint-prettier",
    "rules/lint-protected-paths",
    "rules/lint-solid-d",
    "rules/lint-solid-i",
    "rules/lint-solid-l",
    "rules/lint-solid-o",
    "rules/lint-solid-s",
    "rules/lint-sync-calls",
    "rules/lint-test-determinism",
    "rules/lint-test-disabling-skipping",
    "rules/lint-tests-with-code"
  ],
  "scripts": {
    "build": "tsc -p core/tsconfig.json",
    "watch": "tsc -p core/tsconfig.json --watch",
    "serve": "cd core && node dist/bin/captain-obvious.js serve",
    "dev": "npm run build && (tsc -p core/tsconfig.json --watch & TSC=$!; trap 'kill $TSC 2>/dev/null' EXIT INT TERM; cd core && node --watch dist/bin/captain-obvious.js serve)",
    "prepare": "tsc -p core/tsconfig.json && node core/bin/install.mjs",
    "test": "vitest run --coverage",
    "lint:comments": "captain-obvious-lint comments --staged",
    "lint:comments:all": "captain-obvious-lint comments --all",
    "lint:complexity": "captain-obvious-lint complexity --staged",
    "lint:complexity:all": "captain-obvious-lint complexity --all",
    "lint:coverage": "captain-obvious-lint coverage --staged",
    "lint:coverage:all": "captain-obvious-lint coverage --all",
    "lint:coverage:push": "captain-obvious-lint coverage --push",
    "lint:dead-code": "captain-obvious-lint dead-code --all",
    "lint:dup": "captain-obvious-lint dup --staged",
    "lint:dup-fn": "captain-obvious-lint dup-fn --staged",
    "lint:dup-fn:all": "captain-obvious-lint dup-fn --all",
    "lint:dup-fn:push": "captain-obvious-lint dup-fn --push",
    "lint:dup-structural": "captain-obvious-lint dup-structural --staged",
    "lint:dup-structural:all": "captain-obvious-lint dup-structural --all",
    "lint:dup-structural:push": "captain-obvious-lint dup-structural --push",
    "lint:dup:all": "captain-obvious-lint dup --all",
    "lint:dup:push": "captain-obvious-lint dup --push",
    "lint:emitter-casing": "captain-obvious-lint emitter-casing --staged",
    "lint:emitter-casing:all": "captain-obvious-lint emitter-casing --all",
    "lint:empty-catch": "captain-obvious-lint empty-catch --staged",
    "lint:empty-catch:all": "captain-obvious-lint empty-catch --all",
    "lint:empty-tests": "captain-obvious-lint empty-tests --staged",
    "lint:empty-tests:all": "captain-obvious-lint empty-tests --all",
    "lint:frozen-interfaces": "captain-obvious-lint frozen-interfaces --staged",
    "lint:frozen-interfaces:all": "captain-obvious-lint frozen-interfaces --all",
    "lint:max-file-lines": "captain-obvious-lint max-file-lines --staged",
    "lint:max-file-lines:all": "captain-obvious-lint max-file-lines --all",
    "lint:max-line-length": "captain-obvious-lint max-line-length --staged",
    "lint:max-line-length:all": "captain-obvious-lint max-line-length --all",
    "lint:max-lines": "captain-obvious-lint max-lines --staged",
    "lint:max-lines:all": "captain-obvious-lint max-lines --all",
    "lint:max-params": "captain-obvious-lint max-params --staged",
    "lint:max-params:all": "captain-obvious-lint max-params --all",
    "lint:max-statements": "captain-obvious-lint max-statements --staged",
    "lint:max-statements:all": "captain-obvious-lint max-statements --all",
    "lint:naming": "captain-obvious-lint naming --staged",
    "lint:naming:all": "captain-obvious-lint naming --all",
    "lint:prettier": "captain-obvious-lint prettier --staged",
    "lint:prettier:all": "captain-obvious-lint prettier --all",
    "lint:solid-d": "captain-obvious-lint solid-d --staged",
    "lint:solid-d:all": "captain-obvious-lint solid-d --all",
    "lint:solid-i": "captain-obvious-lint solid-i --staged",
    "lint:solid-i:all": "captain-obvious-lint solid-i --all",
    "lint:solid-l": "captain-obvious-lint solid-l --staged",
    "lint:solid-l:all": "captain-obvious-lint solid-l --all",
    "lint:solid-o": "captain-obvious-lint solid-o --staged",
    "lint:solid-o:all": "captain-obvious-lint solid-o --all",
    "lint:solid-s": "captain-obvious-lint solid-s --staged",
    "lint:solid-s:all": "captain-obvious-lint solid-s --all",
    "lint:sync-calls": "captain-obvious-lint sync-calls --staged",
    "lint:sync-calls:all": "captain-obvious-lint sync-calls --all",
    "lint:test-determinism": "captain-obvious-lint test-determinism --staged",
    "lint:test-determinism:all": "captain-obvious-lint test-determinism --all",
    "lint:test-disabling-skipping": "captain-obvious-lint test-disabling-skipping --staged",
    "lint:test-disabling-skipping:all": "captain-obvious-lint test-disabling-skipping --all",
    "lint:tests-with-code": "captain-obvious-lint tests-with-code --staged",
    "lint:tests-with-code:all": "captain-obvious-lint tests-with-code --all"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "happy-dom": "^20.11.1",
    "vitest": "^2.1.0"
  },
  "captainObvious": {
    "managedScripts": [
      "lint:comments",
      "lint:comments:all",
      "lint:complexity",
      "lint:complexity:all",
      "lint:coverage",
      "lint:coverage:all",
      "lint:coverage:push",
      "lint:dead-code",
      "lint:dup",
      "lint:dup-fn",
      "lint:dup-fn:all",
      "lint:dup-fn:push",
      "lint:dup-structural",
      "lint:dup-structural:all",
      "lint:dup-structural:push",
      "lint:dup:all",
      "lint:dup:push",
      "lint:emitter-casing",
      "lint:emitter-casing:all",
      "lint:empty-catch",
      "lint:empty-catch:all",
      "lint:empty-tests",
      "lint:empty-tests:all",
      "lint:frozen-interfaces",
      "lint:frozen-interfaces:all",
      "lint:max-file-lines",
      "lint:max-file-lines:all",
      "lint:max-line-length",
      "lint:max-line-length:all",
      "lint:max-lines",
      "lint:max-lines:all",
      "lint:max-params",
      "lint:max-params:all",
      "lint:max-statements",
      "lint:max-statements:all",
      "lint:naming",
      "lint:naming:all",
      "lint:prettier",
      "lint:prettier:all",
      "lint:solid-d",
      "lint:solid-d:all",
      "lint:solid-i",
      "lint:solid-i:all",
      "lint:solid-l",
      "lint:solid-l:all",
      "lint:solid-o",
      "lint:solid-o:all",
      "lint:solid-s",
      "lint:solid-s:all",
      "lint:sync-calls",
      "lint:sync-calls:all",
      "lint:test-determinism",
      "lint:test-determinism:all",
      "lint:test-disabling-skipping",
      "lint:test-disabling-skipping:all",
      "lint:tests-with-code",
      "lint:tests-with-code:all"
    ]
  }
}
